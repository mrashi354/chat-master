# Sab keys optional hain — bina inke bhi app free mode me chalati hai.
# Chat (Anthropic Claude). Credit balance hona zaroori hai.
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
CHAT_PROVIDER=auto

# Voice input (Whisper) aur voice output (Cartesia). Inke bina browser speech use hota hai.
OPENAI_API_KEY=your_openai_key_here
OPENAI_STT_MODEL=whisper-1
CARTESIA_API_KEY=your_cartesia_key_here
CARTESIA_MODEL_ID=sonic-english
CARTESIA_VOICE_ID=your_cartesia_voice_id

# Web search (Tavily). Bina key ke DuckDuckGo + Wikipedia fallback.
TAVILY_API_KEY=your_tavily_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Image generation queue priority (optional; anonymous bhi chal jata hai).
AI_HORDE_API_KEY=your_ai_horde_key_here

# Future/realtime voice experimental config (abhi UI me wired nahi hai).
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ENABLE_COMPUTER_CONTROL=false
CONTROL_SECRET=your_control_secret
